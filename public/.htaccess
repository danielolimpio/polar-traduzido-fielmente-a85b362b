# Polar Tensor - SPA fallback + otimizações para Hostinger (Apache)

# ----------------------------------------------------------------------
# 1) SPA Fallback: todas as rotas internas servem o index.html
# ----------------------------------------------------------------------
# Desabilita o auto-redirect 301 do mod_dir que adiciona "/" ao final
# (causa "Página com redirecionamento" no Google Search Console).
DirectoryIndex index.html
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0) BLOQUEIO ANTI-ABUSE / ANTI-FALSO-POSITIVO DE SCANNERS
  #    Retorna 410 Gone REAL (não SPA fallback) para paths típicos de
  #    probes de phishing-kits, CMS abandonados, exploits, etc.
  #    Evita que scanners (PatchStack/Imunify360 da Hostinger) recebam
  #    HTTP 200 em /.lsrecap/recaptcha, /wp-admin, /xmlrpc.php e marquem
  #    o site como infectado por engano.
  RewriteRule ^\.[^/]+ - [R=410,L]
  RewriteRule (^|/)\.(?!well-known)[^/]+ - [R=410,L]
  RewriteRule ^(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php|administrator|phpmyadmin|cgi-bin|\.env|\.git) - [R=410,L,NC]
  RewriteRule (recaptcha|webscr|cmd\.php|shell\.php|c99\.php|r57\.php|filemanager\.php|adminer\.php|eval-stdin\.php)$ - [R=410,L,NC]

  # 1) Canônico ÚNICO: força HTTPS + remove www em um só salto (301)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.polartensor\.trade$ [NC]
  RewriteRule ^(.*)$ https://polartensor.trade/$1 [L,R=301]

  # 2) Remove barra final de URLs (canonicalização) — evita duplicidade
  #    /sobre/  -> /sobre   (301)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 3) Não reescreve arquivos reais (assets, sitemap.xml, robots.txt, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4) Se existir um diretório com index.html (rotas pré-renderizadas:
  #    /sobre/index.html, /en/about/index.html, etc.), serve internamente
  #    SEM redirect — assim a URL canônica /sobre responde 200 direto.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # 5) Fallback SPA: qualquer outra rota -> index.html (React Router resolve)
  RewriteRule ^ /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 2) Cache de assets estáticos (performance / Core Web Vitals / SEO)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 0 seconds"
  ExpiresByType text/xml                      "access plus 0 seconds"
  ExpiresByType application/json              "access plus 0 seconds"

  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType text/javascript               "access plus 1 year"

  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpg                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType video/mp4                     "access plus 1 year"

  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# 3) Compressão (Gzip/Brotli) — reduz tempo de carregamento
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ----------------------------------------------------------------------
# 4) Headers de segurança (bom para SEO e ranking)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HTML não deve ser cacheado de forma agressiva (para refletir updates)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 5) Charset padrão
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8

# ----------------------------------------------------------------------
# 6) Página de erro 404 -> também cai no React Router
# ----------------------------------------------------------------------
ErrorDocument 404 /index.html

# ----------------------------------------------------------------------
# 7) MIME types corretos (sitemap.xml e robots.txt servidos com header certo)
#    Corrige "Não foi possível buscar o sitemap" no Google Search Console
#    quando Hostinger entrega XML como text/html.
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

<Files "sitemap.xml">
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set X-Robots-Tag "noindex"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

<Files "robots.txt">
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=UTF-8"
  </IfModule>
</Files>

